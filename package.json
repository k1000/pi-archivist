{
  "name": "pi-archivist",
  "version": "0.1.0",
  "description": "A Pi extension for durable write-side project memory, documentation maintenance, commit ingestion, and taxonomy-aware knowledge management.",
  "type": "module",
  "license": "MIT",
  "author": "k1000",
  "keywords": ["pi-package", "pi-coding-agent", "pi-extension", "documentation", "memory", "archivist", "taxonomy"],
  "repository": { "type": "git", "url": "git+https://github.com/k1000/pi-archivist.git" },
  "bugs": { "url": "https://github.com/k1000/pi-archivist/issues" },
  "homepage": "https://github.com/k1000/pi-archivist#readme",
  "scripts": {
    "check": "bun scripts/check-extension.ts",
    "test:okf": "bun tests/okf.test.ts",
    "test:config": "bun tests/config-job-log.test.ts",
    "test:memory-api": "bun tests/memory-api.test.ts",
    "test:markdown-note": "bun tests/markdown-note.test.ts",
    "test:hook-safety": "bun tests/hook-safety.test.ts",
    "test": "bun tests/markdown-note.test.ts && bun tests/okf.test.ts && bun tests/config-job-log.test.ts && bun tests/memory-api.test.ts && bun tests/document-chunks.test.ts && bun tests/hook-safety.test.ts",
    "okf": "bun scripts/okf-convert.ts",
    "hook:help": "bun bin/archivist-hook.mjs --help"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"]
  }
}
